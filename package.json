{
  "name": "reveal",
  "version": "0.2.0",
  "private": true,
  "description": "Reveal: an AI-native discovery feed with a curator agent. Node API + Expo (React Native) app.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.js",
    "app": "cd app && npx expo start",
    "web": "node scripts/dev.mjs --web",
    "typecheck": "cd app && npx tsc --noEmit"
  }
}
